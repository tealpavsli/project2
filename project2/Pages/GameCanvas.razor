@page "/"
@using project2.GameEngine
@using project2.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (!HasEnteredName)
{
    <div class="name-entry-overlay">
        <div class="name-entry-box">
            <h2>Введите имя</h2>
            <input @bind="PlayerNameInput" @bind:event="oninput" placeholder="Ваше имя" maxlength="30" />
            <button @onclick="ConfirmName" disabled="@string.IsNullOrWhiteSpace(PlayerNameInput)">Играть</button>
        </div>
    </div>
}
else
{
    <div class="game-container">
    <canvas id="gameCanvas" style="touch-action:none;"></canvas>
    <div class="score-overlay">
        <span>Счёт: @Score</span>
        <span>Рекорд: @Record</span>
    </div>

    @if (IsGameOver)
    {
        <div class="game-over-overlay">
            <div class="game-over-box">
                <h2>Игра окончена</h2>
                <p>Голов: @Score</p>
                <p>Рекорд: @Record</p>
                <button @onclick="RestartGame">Играть снова</button>
            </div>
        </div>
    }

        @if (ShowMessage)
    {
        <div class="message-overlay @(IsConsolingMessage ? "consoling" : "")">
            @foreach (var msg in CurrentMessages)
            {
                <div class="message-line">@msg</div>
            }
        </div>
    }

        @if (ShowGoalAnimation)
    {
        <div class="goal-animation-overlay">
            @if (GoalAnimationType == "confetti")
            {
                @foreach (var piece in ConfettiPieces)
                {
                    <div class="confetti-piece" style="@piece.Style"></div>
                }
            }
            else if (GoalAnimationType == "clapping")
            {
                <div class="clap-hand-wrap clap-hand-wrap-left">
                    <span class="clap-hand clap-hand-left">🤚</span>
                </div>
                <div class="clap-hand-wrap clap-hand-wrap-right">
                    <span class="clap-hand clap-hand-right">🤚</span>
                </div>
            }
            else if (GoalAnimationType == "trophy")
            {
                <div class="trophy-wrap">
                    <span class="trophy-icon">🏆</span>
                </div>
            }
            else if (GoalAnimationType == "thumbsup")
            {
                <div class="thumbsup-wrap">
                    <span class="thumbsup-icon">👍</span>
                    <div class="thumbsup-text">ВО!</div>
                </div>
            }
            else if (GoalAnimationType == "podium")
            {
                <div class="podium-wrap">
                    <div class="podium-stand podium-2">
                        <div class="podium-number">2</div>
                    </div>
                    <div class="podium-stand podium-1">
                        <span class="podium-figure">🙋</span>
                        <div class="podium-number">1</div>
                    </div>
                    <div class="podium-stand podium-3">
                        <div class="podium-number">3</div>
                    </div>
                </div>
            }
        </div>
    }
</div>
}


<div class="score-overlay">
    <span>Счёт: @Score</span>
    <span>Рекорд: @Record</span>
</div>

<div class="lives-overlay">
    @for (var i = 0; i < 5; i++)
    {
        var filled = i < Lives;
        <svg class="heart-icon @(filled ? "filled" : "empty")" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
        </svg>
    }
</div>

@code {
    private GameSession? _session;
    private DotNetObjectReference<GameCanvas>? _selfRef;
    private readonly Random _rng = new();
    private readonly MessageProvider _messageProvider = new(new Random());
    private List<string> CurrentMessages = new();
    private bool ShowMessage;
    private bool IsConsolingMessage;
    private bool ShowGoalAnimation;
    private string GoalAnimationType = "";
    private int _animationIndex;
    private static readonly string[] AvailableAnimations = { "confetti", "clapping", "trophy", "thumbsup", "podium" };
    private string NextAnimationInSequence()
    {
        var animation = AvailableAnimations[_animationIndex % AvailableAnimations.Length];
        _animationIndex++;
        return animation;
    }
    private List<ConfettiPiece> ConfettiPieces = new();

    private class ConfettiPiece
    {
        public string Style { get; set; } = "";
    }

    private static readonly string[] ConfettiColors =
    {
        "#ef4444", "#f59e0b", "#22c55e", "#3b82f6", "#a855f7", "#ec4899"
    };

    private void GenerateConfetti()
    {
        ConfettiPieces.Clear();
        for (var i = 0; i < 1311; i++)
        {
            var left = _rng.NextDouble() * 100;
            var color = ConfettiColors[_rng.Next(ConfettiColors.Length)];
            var duration = 2.0 + _rng.NextDouble() * 1.2;
            var delay = _rng.NextDouble() * 0.4;
            var style = $"left:{left.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%;" +
                        $"background:{color};" +
                        $"animation-duration:{duration.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}s;" +
                        $"animation-delay:{delay.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}s;";
            ConfettiPieces.Add(new ConfettiPiece { Style = style });
        }
    }

    private int Score;
    private int Record;
    private bool IsGameOver;
    private int Lives = 5;
    private bool HasEnteredName;
    private string PlayerNameInput = "";
    private string PlayerName = "";
    private int LoadedRecord;

    private async Task ConfirmName()
    {
        if (string.IsNullOrWhiteSpace(PlayerNameInput)) return;

        PlayerName = PlayerNameInput.Trim();
        LoadedRecord = await JS.InvokeAsync<int>("firebaseInterop.getRecord", PlayerName);
        HasEnteredName = true;
        StateHasChanged();
    }

    private bool _jsInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Инициализируем JS только после того, как введено имя и canvas
        // реально появился в DOM — не обязательно на самом первом рендере
        if (HasEnteredName && !_jsInitialized)
        {
            _jsInitialized = true;
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("gameInterop.init", _selfRef, "gameCanvas");
        }
    }

    [JSInvokable]
    public void OnFieldResized(double width, double height)
    {
        if (_session is null)
        {
            // Самая первая инициализация — обычный старт
            _session = new GameSession(width, height);
            _session.SetInitialRecord(LoadedRecord);
            Score = 0;
            Record = LoadedRecord;
            Lives = 5;
            IsGameOver = false;
        }
        else
        {
            // Повторный ресайз (например, поворот экрана) — переносим прогресс,
            // а не начинаем игру заново
            var savedScore = _session.Score;
            var savedLives = _session.Lives;
            var savedRecord = _session.Record;
            var savedSkin = _session.CurrentSkin;
            var savedColor = _session.CurrentFieldColor;
            var savedSpeedRatio = _session.CurrentSpeed / _session.BaseSpeed;
            var savedSizeMultiplier = _session.Paddle.SizeMultiplier;
            var savedTotalGoals = _session.TotalGoals;
            var wasGameOver = _session.State == GameState.GameOver;

            _session = new GameSession(width, height);
            _session.RestoreProgress(savedScore, savedLives, savedRecord, savedSpeedRatio,
                savedSizeMultiplier, savedSkin, savedColor, wasGameOver, savedTotalGoals);

            Score = _session.Score;
            Record = _session.Record;
            Lives = _session.Lives;
            IsGameOver = wasGameOver;
        }

        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnPointerMove(double x)
    {
        if (IsGameOver) return;
        _session?.MovePaddle(x);
    }

    [JSInvokable]
    public void OnPointerDown()
    {
        if (_session is null || IsGameOver) return;
        if (_session.State == GameState.WaitingToLaunch)
        {
            _session.Launch(_rng);
        }
    }

    [JSInvokable]
    public bool OnSkinSelected(int skinIndex)
    {
        if (_session is null) return false;
        return _session.SetSkin((BallSkin)skinIndex);
    }

    [JSInvokable]
    public bool OnFieldColorSelected(int colorIndex)
    {
        if (_session is null) return false;
        return _session.SetFieldColor((FieldColor)colorIndex);
    }

    [JSInvokable]
    public object OnTick(double dt)
    {
        if (_session is null) return new { };

        var result = _session.Tick(dt);

        if (result == CollisionResult.Goal || result == CollisionResult.BottomLoss)
        {
            Score = _session.Score;
            var newRecord = _session.Record;
            if (newRecord > Record)
            {
                Record = newRecord;
                _ = JS.InvokeVoidAsync("firebaseInterop.saveRecord", PlayerName, Record);
            }
            Lives = _session.Lives;

                        if (result == CollisionResult.Goal)
            {
                if (_session.TotalGoals % 5 == 0)
                {
                    GoalAnimationType = NextAnimationInSequence();
                    if (GoalAnimationType == "confetti")
                    {
                        GenerateConfetti();
                    }
                    ShowGoalAnimation = true;
                    ShowMessage = false;
                }
                else
                {
                    CurrentMessages = _messageProvider.GetNext();
                    ShowMessage = true;
                    IsConsolingMessage = false;
                }
            }
            else if (result == CollisionResult.BottomLoss && _session.State != GameState.GameOver)
            {
                CurrentMessages = new List<string> { _messageProvider.GetConsolingMessage() };
                ShowMessage = true;
                IsConsolingMessage = true;
            }

            if (_session.State == GameState.GameOver)
            {
                IsGameOver = true;
                ShowMessage = false;
                ShowGoalAnimation = false;
            }
            else
            {
                _ = ResumeAfterDelay();
            }

            InvokeAsync(StateHasChanged);
        }

        var h = _session.Heart;
        var p = _session.Paddle;
        var f = _session.Field;

        return new
        {
            fieldWidth = f.Width,
            fieldHeight = f.Height,
            heartX = h.Position.X,
            heartY = h.Position.Y,
            heartRadius = h.Radius,
            paddleLeft = p.Left,
            paddleY = p.Y,
            paddleWidth = p.Width,
            paddleHeight = p.Height,
            goalLeft = f.GoalLeft,
            goalRight = f.GoalRight,
            skin = (int)_session.CurrentSkin,
            isWaiting = _session.State == GameState.WaitingToLaunch,
            fieldColor = (int)_session.CurrentFieldColor
        };
    }

    private void RestartGame()
    {
        _session?.Restart();
        Score = 0;
        Lives = 5;
        IsGameOver = false;
        _animationIndex = 0;
        StateHasChanged();
    }

    private async Task ResumeAfterDelay()
    {
        await Task.Delay(3500);
        ShowMessage = false;
        ShowGoalAnimation = false;
        _session?.ResetForNextAttempt();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _selfRef?.Dispose();
        await Task.CompletedTask;
    }
}